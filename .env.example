# I, Uri, strongly recommend you getting your own *FREE* API keys & accounts.
# Otherwise, you'll fall back to my project-wide shared keys & accounts, which are unfortunately capped.
# If you do hit those quotas, please create your own.

# See at: https://www.geonames.org/login
GEONAMES_USERNAME=<your_geonames_username>

# See at: https://developers.google.com/maps/documentation/maps-static/get-api-key?setupProd=enable
GOOGLE_MAPS_STATIC_API_KEY_PRIMARY=<your_primary_google_maps_static_api_key>
GOOGLE_MAPS_STATIC_API_KEY_ALTERNATIVE=<your_alternative_google_maps_static_api_key>