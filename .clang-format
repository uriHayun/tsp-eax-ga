BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Max line length: break lines too long
ColumnLimit: 100

# Indent 4 spaces after the open bracket, instead of aligning to the bracket
AlignAfterOpenBracket: Align
ContinuationIndentWidth: 4
BinPackParameters: OnePerLine
BinPackArguments: false

# Braces
BreakBeforeBraces: Attach # K&R
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty

# Pointers & references: int *ptr
DerivePointerAlignment: false
PointerAlignment: Right

# Sort library-includes alphabetically
SortIncludes:
  Enabled: true
  IgnoreCase: false

# if(condition) -> if (condition)
SpaceBeforeParens: ControlStatements

# Prevent extra spaces inside parentheses/square-brackets
SpacesInParensOptions:
  InConditionalStatements: false
  InCStyleCasts: false
  InEmptyParentheses: false
SpacesInSquareBrackets: false

# Trailing comments: at least spaces before "//", leave alignment as-is
SpacesBeforeTrailingComments: 2
AlignTrailingComments:
  Kind: Leave
